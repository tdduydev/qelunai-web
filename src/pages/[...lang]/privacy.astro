---
import LegalPage from '../../layouts/LegalPage.astro';
import { localePaths, rich } from '../../i18n';
import { policyFor } from '../../lib/policy';

export const getStaticPaths = localePaths;

const { locale } = Astro.props;
const t = locale.pages.privacy;
const policy = policyFor(locale.code);
---

<LegalPage locale={locale} page="privacy" title={t.title} description={t.description} updated={policy.updated}>
  <nav class="toc" slot="aside" aria-labelledby="toc-title">
    <h2 id="toc-title">{t.onThisPage}</h2>
    <ol>
      {policy.sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
    </ol>
  </nav>
  <Fragment set:html={policy.html} />
  <p class="contact-line" set:html={rich(t.contact)} />
</LegalPage>
