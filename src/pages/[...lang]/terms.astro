---
import Blocks from '../../components/Blocks.astro';
import LegalPage from '../../layouts/LegalPage.astro';
import { localePaths } from '../../i18n';

export const getStaticPaths = localePaths;

const { locale } = Astro.props;
const t = locale.pages.terms;
---

<LegalPage
  locale={locale}
  page="terms"
  title={t.title}
  description={t.description}
  updated={`${locale.pages.updatedLabel} ${t.updated}`}
  lead={t.lead}
  notice={locale.pages.translationNotice}
>
  <Blocks blocks={t.blocks} />
</LegalPage>
