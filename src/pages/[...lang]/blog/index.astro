---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import StoreButtons from '../../../components/StoreButtons.astro';
import { localePaths, pathFor } from '../../../i18n';
import { blogPath, postsFor } from '../../../lib/blog';

export const getStaticPaths = localePaths;

const { locale } = Astro.props;
const t = locale.blog;
const posts = await postsFor(locale.code);
const day = new Intl.DateTimeFormat(locale.htmlLang, { dateStyle: 'long', timeZone: 'Asia/Ho_Chi_Minh' });
const abs = (path: string) => new URL(path, Astro.site).href;
const rss = { href: `${blogPath(locale.code)}rss.xml`, title: t.feedTitle };
const schema = [
  {
    '@type': 'Blog',
    name: t.feedTitle,
    url: abs(blogPath(locale.code)),
    inLanguage: locale.htmlLang,
    blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.title, url: abs(blogPath(locale.code, p.slug)), datePublished: p.date.toISOString() })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Qelunai', item: abs(pathFor(locale)) },
      { '@type': 'ListItem', position: 2, name: t.title, item: abs(blogPath(locale.code)) },
    ],
  },
];
---

<Base locale={locale} page="blog" title={`${t.title} · Qelunai`} description={t.description} schema={schema} rss={rss}>
  <section class="blog">
    <header class="blog-head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1>{t.title}</h1>
      <p class="lede">{t.lead}</p>
      <a class="link rss-link" href={rss.href}>{t.rss}</a>
    </header>
    {
      posts.length ? (
        <ul class="post-list">
          {posts.map((p) => (
            <li>
              <a class="post-card card" href={blogPath(locale.code, p.slug)}>
                <Image src={p.entry.data.cover} alt={p.entry.data.coverAlt} width={600} height={315} fit="cover" format="webp" quality={72} />
                <div class="post-card-body">
                  <p class="post-meta">
                    <time datetime={p.date.toISOString()}>{day.format(p.date)}</time> · {t.minutes.replace('{n}', String(p.readingMinutes))}
                  </p>
                  <h2>{p.title}</h2>
                  <p>{p.summary}</p>
                  <span class="link">{t.readMore} →</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="blog-empty">{t.empty}</p>
      )
    }
    <aside class="blog-cta">
      <p>{t.cta}</p>
      <StoreButtons locale={locale} />
    </aside>
  </section>
</Base>
