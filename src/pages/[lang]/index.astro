---
import LandingPage from '../../components/LandingPage.astro';
import { otherLocales, type Locale } from '../../i18n';

export function getStaticPaths() {
  return otherLocales.map((locale) => ({ params: { lang: locale.code }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
---

<LandingPage locale={locale} />
