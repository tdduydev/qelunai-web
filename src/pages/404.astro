---
import Base from '../layouts/Base.astro';
import { defaultLocale, locales, pathFor } from '../i18n';

const t = defaultLocale.notFound;
---

<Base locale={defaultLocale} title={`${t.title} · Qelunai`} description={t.body} noindex>
  <section class="not-found" aria-labelledby="nf-title">
    <h1 id="nf-title">{t.title}</h1>
    <p>{t.body}</p>
    <ul>
      {locales.map((l) => <li><a class="btn btn-gold" href={pathFor(l)} lang={l.htmlLang}>{l.notFound.home}</a></li>)}
    </ul>
  </section>
</Base>

<style>
  .not-found {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
    padding: calc(var(--header-h) + 40px) var(--m) 64px;
    color: var(--paper);
  }
  h1 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(52px, 8vw, 128px);
    line-height: 1;
    letter-spacing: -0.02em;
    max-width: 14ch;
  }
  p {
    color: var(--paper-80);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
