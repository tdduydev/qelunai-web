---
import { pathFor, type Locale } from '../i18n';
interface Props {locale:Locale;class?:string}
const {locale,class:className}=Astro.props;
const subject=encodeURIComponent('[Qelunai iOS beta] '+locale.beta.iosSubject);
const href=`mailto:support@qelunai.com?subject=${subject}`;
---
<div class:list={['stores',className]}>
  <a class="btn btn-gold" href={pathFor(locale,'testers')} data-cta="android-beta" data-source="store-buttons">{locale.beta.android}</a>
  <a class="store" href={href} data-cta="ios-beta-email" data-source="store-buttons">{locale.beta.ios}</a>
</div>
