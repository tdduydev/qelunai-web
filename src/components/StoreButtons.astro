---
import type { Locale } from '../i18n';
interface Props { locale:Locale; class?:string; }
const { locale, class: className } = Astro.props;
const vi=locale.code==='vi';
const subject=encodeURIComponent('[Qelunai beta] '+(vi?'Yêu cầu dùng thử':'Request beta access'));
const body=encodeURIComponent(vi?'Tôi muốn dùng thử Qelunai trên iOS/Android: ':'I would like to test Qelunai on iOS/Android: ');
const href=`mailto:support@qelunai.com?subject=${subject}&body=${body}`;
---
<div class:list={['stores',className]}>
  <a class="btn btn-gold" href={href} data-cta="beta-email" data-source="store-buttons">{vi?'Đăng ký dùng thử':'Request beta access'}</a>
</div>
