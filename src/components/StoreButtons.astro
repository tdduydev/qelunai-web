---
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
const t = locale.store;
---

<!-- Store links are placeholders: replace each href="#" once the listings are live (search for data-store-link). -->
<div class:list={['stores', className]}>
  <a class="store" href="#" data-store-link="app-store">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <path
        fill="currentColor"
        d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.6 0 2 .8 3.4.8 1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9 0 0-2.7-1-2.7-4.1zM13.9 5c.7-.9 1.2-2 1-3.2-1 0-2.3.7-3 1.6-.7.8-1.2 2-1.1 3.1 1.2.1 2.3-.6 3.1-1.5z"
      ></path>
    </svg>
    <span><small>{t.getOn}</small>{t.appStore}</span>
  </a>
  <a class="store" href="#" data-store-link="google-play">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <path fill="currentColor" d="M4 2.6c-.3.3-.4.7-.4 1.2v16.4c0 .5.1.9.4 1.2l9.2-9.4L4 2.6zm10.3 10.5 2.6 2.6-11.1 6.4 8.5-9zm0-2.2L5.8 2.3l11.1 6.4-2.6 2.6zm3.7-1.6 3.1 1.8c.9.5.9 1.3 0 1.8l-3.1 1.8-2.8-2.7 2.8-2.7z"></path>
    </svg>
    <span><small>{t.getOn}</small>{t.googlePlay}</span>
  </a>
</div>
