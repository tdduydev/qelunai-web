---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import StoreButtons from './StoreButtons.astro';
import { pathFor, rich, type FeatureId, type Locale } from '../i18n';
import trongdong from '../assets/sonmai/trongdong.webp';
import sen from '../assets/sonmai/sen-sonmai.webp';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = locale;

const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*/*.png', { eager: true });
const icons = import.meta.glob<{ default: ImageMetadata }>('../assets/sonmai/icons/*.webp', { eager: true });
const shot = (name: string) => (shots[`../assets/shots/${locale.code}/${name}.png`] ?? shots[`../assets/shots/vi/${name}.png`]).default;
const icon = (name: string) => icons[`../assets/sonmai/icons/${name}.webp`].default;

/** Features shown with an app screenshot, in page order, and their medallion icon. */
const rows: { id: FeatureId; shot: string; icon: string }[] = [
  { id: 'today', shot: 'home', icon: 'ngaygio' },
  { id: 'licham', shot: 'calendar', icon: 'licham' },
  { id: 'kinhdich', shot: 'modules-kinhdich', icon: 'kinhdich' },
  { id: 'phongthuy', shot: 'la-ban', icon: 'phongthuy' },
  { id: 'giadinh', shot: 'gia-dinh', icon: 'giadinh' },
];
/** Features shown as cards, without a screenshot. */
const cards: { id: FeatureId; icon: string }[] = [
  { id: 'thansohoc', icon: 'thansohoc' },
  { id: 'batu', icon: 'batu' },
];
const shotWidths = [260, 340, 520];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <h1 id="hero-title">
      {t.hero.title}
      <em class="gold-text">{t.hero.accent}</em>
    </h1>
    <p class="lede">{t.hero.sub}</p>
    <StoreButtons locale={locale} />
    <p class="note">{t.store.soon}</p>
  </div>
  <div class="hero-visual">
    <Image class="drum" src={trongdong} alt="" widths={[360, 720]} sizes="(min-width: 960px) 620px, 120vw" loading="eager" />
    <figure class="phone">
      <Image src={shot('home')} alt={t.hero.shotAlt} widths={shotWidths} sizes="(min-width: 960px) 300px, 64vw" loading="eager" fetchpriority="high" />
    </figure>
  </div>
</section>

<section class="growth-landing section" aria-labelledby="growth-tools-title">
  <p class="eyebrow">{t.tools.eyebrow}</p>
  <h2 id="growth-tools-title">{t.tools.heading}</h2>
  <div class="growth-links">
    <a class="card" href={pathFor(locale,'calendar')}>{t.tools.calendar} →</a>
    <a class="card" href={pathFor(locale,'hours')}>{t.tools.hours} →</a>
    <a class="card" href={pathFor(locale,'iching')}>{t.tools.iching} →</a>
  </div>
</section>

<section id="features" class="section features" aria-labelledby="features-title">
  <header class="section-head" data-reveal>
    <p class="eyebrow">{t.features.eyebrow}</p>
    <h2 id="features-title">{t.features.heading}</h2>
    <p>{t.features.sub}</p>
  </header>

  {
    rows.map(({ id, shot: name, icon: iconName }, i) => {
      const f = t.features.items[id];
      return (
        <article class:list={['feature', { flip: i % 2 === 1 }]} id={`feature-${id}`} data-reveal>
          <div class="feature-copy">
            <p class="kicker">
              <Image src={icon(iconName)} alt="" width={44} height={44} />
              <span>{f.kicker}</span>
            </p>
            <h3>{f.name}</h3>
            <p>{f.summary}</p>
            <ul class="points">
              {f.points.map((point) => <li>{point}</li>)}
            </ul>
          </div>
          <figure class="phone">
            <Image src={shot(name)} alt={f.shotAlt ?? ''} widths={shotWidths} sizes="(min-width: 960px) 280px, 64vw" />
          </figure>
        </article>
      );
    })
  }

  <div class="feature-cards">
    {
      cards.map(({ id, icon: iconName }) => {
        const f = t.features.items[id];
        return (
          <article class="card medallion-card" id={`feature-${id}`} data-reveal>
            <Image src={icon(iconName)} alt="" width={72} height={72} />
            <p class="kicker">{f.kicker}</p>
            <h3>{f.name}</h3>
            <p>{f.summary}</p>
            <ul class="points">
              {f.points.map((point) => <li>{point}</li>)}
            </ul>
          </article>
        );
      })
    }
  </div>
</section>

<section class="section extras" aria-labelledby="extras-title">
  <header class="section-head" data-reveal>
    <p class="eyebrow">{t.extras.eyebrow}</p>
    <h2 id="extras-title">{t.extras.heading}</h2>
  </header>
  <ul class="extras-grid">
    {
      t.extras.items.map((item) => (
        <li class="card" data-reveal>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))
    }
  </ul>
</section>

<section class="principles" aria-labelledby="principles-title">
  <div class="paper" data-reveal>
    <span class="seal" aria-hidden="true">{t.principles.seal}</span>
    <p class="eyebrow">{t.principles.eyebrow}</p>
    <h2 id="principles-title">{t.principles.heading}</h2>
    <ol>
      {
        t.principles.items.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section id="faq" class="section faq" aria-labelledby="faq-title">
  <header class="section-head" data-reveal>
    <p class="eyebrow">{t.faq.eyebrow}</p>
    <h2 id="faq-title">{t.faq.heading}</h2>
  </header>
  <div class="faq-list" data-reveal>
    {
      t.faq.items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p set:html={rich(item.a)} />
        </details>
      ))
    }
  </div>
  <p class="faq-more"><a class="link" href={pathFor(locale, 'support')}>{t.faq.more} →</a></p>
</section>

<section id="download" class="download" aria-labelledby="download-title">
  <Image class="download-art" src={sen} alt={t.download.pictureAlt} widths={[360, 780]} sizes="(min-width: 960px) 420px, 80vw" />
  <div class="download-copy" data-reveal>
    <h2 id="download-title">{t.download.heading}</h2>
    <p>{t.download.sub}</p>
    <StoreButtons locale={locale} />
    <p class="note">{t.store.soon}</p>
  </div>
</section>
