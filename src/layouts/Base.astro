---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Mark from '../components/Mark.astro';
import { alternatesFor, email, homeFor, isPolicyOnly, locales, defaultLocale, pathFor, type Locale, type PageId, type PolicyLocale } from '../i18n';

interface Props {
  /** A privacy-only language gets a header and footer with just the language menu and links to the vi/en home pages. */
  locale: Locale | PolicyLocale;
  /** Which page this is; canonical, hreflang and the language switch point at its siblings. */
  page?: PageId;
  /** Page-specific title; defaults to the locale's SEO title. */
  title?: string;
  description?: string;
  /** Pages that should not be indexed, e.g. 404. Also drops hreflang alternates. */
  noindex?: boolean;
  /** Extra JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
}

const { locale, page = 'home', noindex = false, schema = [] } = Astro.props;
const policyOnly = isPolicyOnly(locale) ? locale : undefined;
const full = isPolicyOnly(locale) ? undefined : locale;
const defaults = isPolicyOnly(locale)
  ? { title: locale.title, description: locale.description, nav: { skip: locale.skip, home: locale.home, language: locale.language } }
  : { title: locale.seo.title, description: locale.seo.description, nav: locale.nav };
const { title = defaults.title, description = defaults.description } = Astro.props;
const nav = defaults.nav;
const alternates = alternatesFor(page);

const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href;
const canonical = abs(pathFor(locale, page));
const ogImage = abs('/og.png');
const home = homeFor(locale);

const graph = [
  {
    '@type': 'Organization',
    '@id': `${site.href}#organization`,
    name: 'Qelunai',
    url: site.href,
    logo: abs('/icon-512.png'),
    email,
  },
  {
    '@type': 'WebSite',
    '@id': `${site.href}#website`,
    name: 'Qelunai',
    url: site.href,
    inLanguage: locales.map((l) => l.htmlLang),
    publisher: { '@id': `${site.href}#organization` },
  },
  ...schema,
];
---

<!doctype html>
<html lang={locale.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        // Hidden-before-reveal styles only apply when motion is welcome; a timer
        // shows everything anyway if the reveal script never runs.
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('motion');
          setTimeout(() => root.classList.add('motion-fallback'), 4000);
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && page === 'home' && full && <meta name="keywords" content={full.seo.keywords} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((l) => <link rel="alternate" hreflang={l.hreflang} href={abs(l.href)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={abs(pathFor(defaultLocale, page))} />}

    <meta name="theme-color" content="#0D0A08" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/icon-512.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href="/fonts/BeVietnamPro-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/PlayfairDisplay-Variable.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Qelunai" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={full?.seo.ogAlt ?? 'Qelunai'} />
    <meta property="og:locale" content={locale.ogLocale} />
    {alternates.filter((l) => l.code !== locale.code).map((l) => <meta property="og:locale:alternate" content={l.ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  </head>
  <body>
    <a class="skip" href="#main">{nav.skip}</a>
    <header class="site-header">
      <a class="brand" href={home} aria-label={nav.home}>
        <Mark size={30} />
        <span>Qelunai</span>
      </a>
      {
        full && (
          <nav class="site-nav" aria-label={full.nav.home}>
            <a href={pathFor(full, 'calendar')}>{full.code === 'vi' ? 'Lịch âm' : 'Lunar calendar'}</a>
            <a href={`${home}#features`}>{full.nav.features}</a>
            <a href={`${home}#faq`}>{full.nav.faq}</a>
            <a href={pathFor(full, 'support')} aria-current={page === 'support' ? 'page' : undefined}>{full.nav.support}</a>
          </nav>
        )
      }
      <ul class="lang" aria-label={nav.language}>
        {
          alternates.map((l) => (
            <li>
              <a
                href={l.href}
                hreflang={l.hreflang}
                lang={l.htmlLang}
                title={l.nativeName}
                aria-current={l.code === locale.code ? 'true' : undefined}
              >
                {locales.some((f) => f.code === l.code) ? l.code.toUpperCase() : l.nativeName}
              </a>
            </li>
          ))
        }
      </ul>
      {full && <a class="btn btn-gold header-action" href={`${home}#download`}>{full.nav.action}</a>}
    </header>
    <main id="main">
      <slot />
    </main>
    {
      policyOnly ? (
        <footer class="site-footer">
          <div class="footer-base">
            <p>
              {policyOnly.homeLinks}{' '}
              {locales.map((l, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={pathFor(l)} hreflang={l.code} lang={l.htmlLang}>
                    {l.nativeName}
                  </a>
                </>
              ))}
              {' · '}
              <a href={`mailto:${email}`}>{email}</a>
            </p>
            <p>© {new Date().getFullYear()} Qelunai</p>
          </div>
        </footer>
      ) : (
        full && <Footer locale={full} />
      )
    }
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
