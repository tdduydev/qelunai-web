---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Mark from '../components/Mark.astro';
import { alternatesFor, email, locales, defaultLocale, pathFor, type Locale, type PageId } from '../i18n';

interface Props {
  locale: Locale;
  /** Which page this is; canonical, hreflang and the language switch point at its siblings. */
  page?: PageId;
  /** Page-specific title; defaults to the locale's SEO title. */
  title?: string;
  description?: string;
  /** Pages that should not be indexed, e.g. 404. Also drops hreflang alternates. */
  noindex?: boolean;
  /** Extra JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
}

const { locale, page = 'home', noindex = false, schema = [] } = Astro.props;
const { title = locale.seo.title, description = locale.seo.description } = Astro.props;
const nav = locale.nav;
const alternates = alternatesFor(page);

const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href;
const canonical = abs(pathFor(locale, page));
const ogImage = abs('/og.png');
const home = pathFor(locale);

const graph = [
  {
    '@type': 'Organization',
    '@id': `${site.href}#organization`,
    name: 'Qelunai',
    url: site.href,
    logo: abs('/icon-512.png'),
    email,
  },
  {
    '@type': 'WebSite',
    '@id': `${site.href}#website`,
    name: 'Qelunai',
    url: site.href,
    inLanguage: locales.map((l) => l.htmlLang),
    publisher: { '@id': `${site.href}#organization` },
  },
  ...schema,
];
---

<!doctype html>
<html lang={locale.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        // Hidden-before-reveal styles only apply when motion is welcome; a timer
        // shows everything anyway if the reveal script never runs.
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('motion');
          setTimeout(() => root.classList.add('motion-fallback'), 4000);
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && page === 'home' && <meta name="keywords" content={locale.seo.keywords} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((l) => <link rel="alternate" hreflang={l.hreflang} href={abs(l.href)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={abs(pathFor(defaultLocale, page))} />}

    <meta name="theme-color" content="#0D0A08" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/icon-512.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href="/fonts/BeVietnamPro-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/PlayfairDisplay-Variable.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Qelunai" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={locale.seo.ogAlt} />
    <meta property="og:locale" content={locale.ogLocale} />
    {alternates.filter((l) => l.code !== locale.code).map((l) => <meta property="og:locale:alternate" content={l.ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  </head>
  <body>
    <a class="skip" href="#main">{nav.skip}</a>
    <header class="site-header">
      <a class="brand" href={home} aria-label={nav.home}>
        <Mark size={30} />
        <span>Qelunai</span>
      </a>
      <nav class="site-nav" aria-label={nav.home}>
        <a href={pathFor(locale, 'calendar')}>{nav.calendar}</a>
        <a href={`${home}#features`}>{nav.features}</a>
        <a href={`${home}#faq`}>{nav.faq}</a>
        <a href={pathFor(locale, 'support')} aria-current={page === 'support' ? 'page' : undefined}>{nav.support}</a>
      </nav>
      <ul class="lang" aria-label={nav.language}>
        {
          alternates.map((l) => (
            <li>
              <a
                href={l.href}
                hreflang={l.hreflang}
                lang={l.htmlLang}
                title={l.nativeName}
                aria-current={l.code === locale.code ? 'true' : undefined}
              >
                {l.menuLabel}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn-gold header-action" href={`${home}#download`}>{nav.action}</a>
    </header>
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
